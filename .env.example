# Application Configuration
PROJECT_NAME="Online Book Store"
VERSION="1.0.0"
API_V1_STR="/api/v1"

# Security & JWT Tokens
SECRET_KEY="your_super_secret_access_token_key_here"
REFRESH_SECRET_KEY="your_super_secret_refresh_token_key_here"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database Configuration (Separate Variables - DO NOT use single DATABASE_URL)
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=task2_db
DATABASE_USER=postgres
DATABASE_PASS=postgres

# Initial Admin Credentials (Used by seed.py)
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@bookstore.com
ADMIN_PASSWORD=AdminPassword123!

# AI Architecture (Leave OPENAI_API_KEY empty until Phase 13)
OPENAI_API_KEY=

# Stripe Payment Architecture
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
